STYLE direct 
--- a/Makefile
+++ b/Makefile
@@ -1,7 +1,7 @@
 CFLAGS = -O0
 app: main.o helper.o
 	gcc main.o helper.o -o app
-main.o: main.c unused.h
+main.o: main.c unused.h config.h
 	gcc $(CFLAGS) -c main.c -o main.o
 helper.o: helper.c
 	gcc $(CFLAGS) -c helper.c -o helper.o

PLAN [{'target': 'main.o', 'dependency': 'config.h', 'style': 'direct'}]
STYLE macro 
--- a/Makefile
+++ b/Makefile
@@ -1,4 +1,4 @@
-DEPS = main.c unused.h
+DEPS = main.c unused.h config.h
 CFLAGS = -O0
 app: main.o helper.o
 	gcc main.o helper.o -o app

PLAN [{'target': 'main.o', 'dependency': 'config.h', 'style': 'macro'}]
STYLE mixed 
--- a/Makefile
+++ b/Makefile
@@ -2,7 +2,7 @@
 CFLAGS = -O0
 app: main.o helper.o
 	gcc main.o helper.o -o app
-main.o: main.c $(HEADERS)
+main.o: main.c $(HEADERS) config.h
 	gcc $(CFLAGS) -c main.c -o main.o
 helper.o: helper.c
 	gcc $(CFLAGS) -c helper.c -o helper.o

PLAN [{'target': 'main.o', 'dependency': 'config.h', 'style': 'mixed'}]
ALL_THREE_SOURCE_PROJECTS_CLEAN
STEP_EXIT_CODE=0
